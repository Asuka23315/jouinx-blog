---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import type { NovelChapter } from "@utils/novel-utils";
import { getNovelUrl } from "@utils/url-utils";
import PostMetadata from "./PostMeta.astro";

interface Props {
	class?: string;
	style?: string;
	series: string;
	entry: CollectionEntry<"posts">;
	latestEntry: CollectionEntry<"posts">;
	chapters: NovelChapter[];
}

const { series, entry, latestEntry, chapters } = Astro.props;
const className = Astro.props.class;
const style = Astro.props.style;
const novelUrl = getNovelUrl(series);
const lastChapter = chapters[chapters.length - 1];
const chapterSummary =
	chapters.length > 1
		? `共 ${chapters.length} 章 · 已更新至第 ${lastChapter?.chapter ?? "?"} 章`
		: chapters.length === 1
			? "共 1 章"
			: "";

// 系列卡片在列表中按最新章节的位置显示，
// 但分类与标签优先使用第 1 章的元信息，避免最新章节留空时显示成“未分类”。
const cardTags = entry.data.tags.length > 0 ? entry.data.tags : latestEntry.data.tags;
const cardCategory = entry.data.category || latestEntry.data.category;
---

<div
	class:list={[
		"card-base flex flex-col-reverse md:flex-col w-full rounded-[var(--radius-large)] overflow-hidden relative",
		className,
	]}
	style={style}
>
	<div
		class="pl-6 md:pl-9 pr-6 md:pr-3 pt-6 md:pt-7 pb-6 relative w-full md:w-[calc(100%_-_52px_-_12px)]"
	>
		<a
			href={novelUrl}
			class="transition group w-full block font-bold mb-3 text-3xl text-90
				hover:text-[var(--primary)] dark:hover:text-[var(--primary)]
				active:text-[var(--title-active)] dark:active:text-[var(--title-active)]
				before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
				before:absolute before:top-[35px] before:left-[18px] before:hidden md:before:block"
		>
			《{series}》
		</a>

		<PostMetadata
			published={latestEntry.data.published}
			updated={latestEntry.data.updated}
			tags={cardTags}
			category={cardCategory}
			hideTagsForMobile={true}
			hideUpdateDate={true}
			class="mb-4"
		></PostMetadata>

		<div class="transition text-75 mb-4 pr-4 text-sm">
			{chapterSummary}
			<span class="mx-2 text-black/25 dark:text-white/25">·</span>
			点击查看全部章节
		</div>

		<a
			href={novelUrl}
			aria-label={`打开《${series}》目录`}
			class="btn-regular rounded-xl px-4 h-10 text-sm font-bold w-fit gap-2"
		>
			<Icon class="text-lg" name="material-symbols:book-2-outline-rounded"></Icon>
			查看目录
		</a>
	</div>

	<a
		href={novelUrl}
		aria-label={`打开《${series}》目录`}
		class="!hidden md:!flex btn-regular w-[3.25rem]
			absolute right-3 top-3 bottom-3 rounded-xl bg-[var(--enter-btn-bg)]
			hover:bg-[var(--enter-btn-bg-hover)] active:bg-[var(--enter-btn-bg-active)] active:scale-95"
	>
		<Icon
			class="transition text-[var(--primary)] text-4xl mx-auto"
			name="material-symbols:chevron-right-rounded"
		></Icon>
	</a>
</div>
<div class="transition border-t-[1px] border-dashed mx-6 border-black/10 dark:border-white/[0.15] last:border-t-0 md:hidden"></div>
