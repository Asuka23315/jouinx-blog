---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import type { NovelChapter } from "@utils/novel-utils";
import { getNovelSeries } from "@utils/novel-utils";
import { getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
	const seriesList = await getNovelSeries();
	return seriesList.map((series) => ({
		params: { series: series.series },
		props: { seriesName: series.series, chapters: series.chapters },
	}));
}

const { seriesName, chapters } = Astro.props as {
	seriesName: string;
	chapters: NovelChapter[];
};
---

<MainGridLayout title={`《${seriesName}》`} description={`《${seriesName}》目录`}>
	<div class="card-base px-6 md:px-9 py-6 mb-4">
		<h1 class="font-bold text-2xl md:text-3xl text-90">《{seriesName}》</h1>
		<p class="mt-2 text-sm text-50">目录 · 共 {chapters.length} 章</p>
	</div>

	<div class="card-base px-2 md:px-4 py-2">
		{chapters.map((chapter) => (
			<a
				href={getPostUrlBySlug(chapter.slug)}
				class="group flex items-center gap-3 md:gap-4 rounded-xl px-3 md:px-5 py-3 hover:bg-[var(--btn-plain-bg-hover)] active:bg-[var(--btn-plain-bg-active)]"
			>
				<span class="shrink-0 w-20 md:w-24 text-sm md:text-base font-bold text-50 group-hover:text-[var(--primary)]">
					第 {chapter.chapter} 章
				</span>
				<span class="min-w-0 flex-1 truncate text-black/80 dark:text-white/80 group-hover:text-[var(--primary)]">
					{chapter.title}
				</span>
				<Icon
					class="shrink-0 text-[var(--primary)] opacity-0 group-hover:opacity-100 -translate-x-1 group-hover:translate-x-0 transition"
					name="material-symbols:chevron-right-rounded"
				/>
			</a>
		))}
	</div>
</MainGridLayout>
